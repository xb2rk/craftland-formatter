{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FC Formatter v5 project config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "printWidth": {
      "description": "Target display columns for groups.",
      "default": 120,
      "examples": [
        100
      ],
      "type": "integer",
      "minimum": 1
    },
    "indent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": {
          "description": "Indent with spaces or tabs.",
          "default": "space",
          "examples": [
            "tab"
          ],
          "type": "string",
          "enum": [
            "space",
            "tab"
          ]
        },
        "size": {
          "description": "Spaces per indent level when indent.style is space.",
          "default": 2,
          "examples": [
            4
          ],
          "type": "integer",
          "minimum": 1
        },
        "continuation": {
          "description": "Extra indent levels for broken binary-expression tails.",
          "default": 1,
          "examples": [
            2
          ],
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collections": {
          "description": "Align map colons and struct equals signs in broken collections.",
          "default": true,
          "examples": [
            false
          ],
          "type": "boolean"
        },
        "enums": {
          "description": "Align equals signs and trailing comments in enum declarations.",
          "default": true,
          "examples": [
            false
          ],
          "type": "boolean"
        },
        "fields": {
          "description": "Align names, types, and equals signs in tuple, component, and graph field declarations.",
          "default": true,
          "examples": [
            false
          ],
          "type": "boolean"
        }
      }
    },
    "endOfLine": {
      "description": "Line ending for generated layout.",
      "default": "preserve",
      "examples": [
        "crlf"
      ],
      "type": "string",
      "enum": [
        "lf",
        "crlf",
        "preserve"
      ]
    },
    "finalNewline": {
      "description": "Append a final line ending when missing.",
      "default": true,
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "lineBreaks": {
      "description": "Reflow safe groups or retain existing breaks.",
      "default": "canonical",
      "examples": [
        "preserve"
      ],
      "type": "string",
      "enum": [
        "canonical",
        "preserve"
      ]
    },
    "wrap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "calls": {
          "description": "Wrapping of call arguments.",
          "default": "preserve",
          "examples": [
            "auto"
          ],
          "type": "string",
          "enum": [
            "preserve",
            "auto",
            "always",
            "never"
          ]
        },
        "parameters": {
          "description": "Preserve parameter line-break positions or reflow function/event and function-type signatures.",
          "default": "preserve",
          "examples": [
            "auto"
          ],
          "type": "string",
          "enum": [
            "preserve",
            "auto",
            "always",
            "never"
          ]
        },
        "collections": {
          "description": "Wrapping of collection entries.",
          "default": "auto",
          "examples": [
            "always"
          ],
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ]
        },
        "conditions": {
          "description": "Wrapping of logical chains in conditions, assignments, returns and group items.",
          "default": "auto",
          "examples": [
            "always"
          ],
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ]
        }
      }
    },
    "spacing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operators": {
          "description": "Spaces around binary and compound operators; required lexical separators remain.",
          "default": "spaced",
          "examples": [
            "compact"
          ],
          "type": "string",
          "enum": [
            "spaced",
            "compact"
          ]
        },
        "assignment": {
          "description": "Spaces around = and :=; inherit follows spacing.operators.",
          "default": "inherit",
          "examples": [
            "compact"
          ],
          "type": "string",
          "enum": [
            "inherit",
            "spaced",
            "compact"
          ]
        },
        "comma": {
          "description": "Space after commas in flat groups.",
          "default": "spaced",
          "examples": [
            "compact"
          ],
          "type": "string",
          "enum": [
            "spaced",
            "compact"
          ]
        },
        "brackets": {
          "description": "Padding inside flat collections.",
          "default": "tight",
          "examples": [
            "spaced"
          ],
          "type": "string",
          "enum": [
            "tight",
            "spaced"
          ]
        }
      }
    },
    "imports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sort": {
          "description": "Sort complete imports with attached comments into standard, Contracts and project groups.",
          "default": true,
          "examples": [
            false
          ],
          "type": "boolean"
        }
      }
    },
    "blankLines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxConsecutive": {
          "description": "Maximum source blank lines kept between entries.",
          "default": 1,
          "examples": [
            0
          ],
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "afterImports": {
          "description": "Blank line after the last import.",
          "default": "always",
          "examples": [
            "preserve"
          ],
          "type": "string",
          "enum": [
            "always",
            "preserve",
            "never"
          ]
        },
        "betweenMembers": {
          "description": "Blank lines between graph or declaration members.",
          "default": "preserve",
          "examples": [
            "always"
          ],
          "type": "string",
          "enum": [
            "preserve",
            "always",
            "never"
          ]
        },
        "betweenFunctions": {
          "description": "Enforce a blank line between function and event members in graphs.",
          "default": "preserve",
          "examples": [
            "always"
          ],
          "type": "string",
          "enum": [
            "always",
            "preserve",
            "never"
          ]
        }
      }
    },
    "syntax": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonicalHeaders": {
          "description": "Keep or strip redundant parentheses around if/for/while condition headers.",
          "default": "preserve",
          "examples": [
            "canonical"
          ],
          "type": "string",
          "enum": [
            "preserve",
            "canonical"
          ]
        }
      }
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "overrides": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "files",
          "options"
        ],
        "properties": {
          "files": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "printWidth": {
                "description": "Target display columns for groups.",
                "default": 120,
                "examples": [
                  100
                ],
                "type": "integer",
                "minimum": 1
              },
              "indent": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "style": {
                    "description": "Indent with spaces or tabs.",
                    "default": "space",
                    "examples": [
                      "tab"
                    ],
                    "type": "string",
                    "enum": [
                      "space",
                      "tab"
                    ]
                  },
                  "size": {
                    "description": "Spaces per indent level when indent.style is space.",
                    "default": 2,
                    "examples": [
                      4
                    ],
                    "type": "integer",
                    "minimum": 1
                  },
                  "continuation": {
                    "description": "Extra indent levels for broken binary-expression tails.",
                    "default": 1,
                    "examples": [
                      2
                    ],
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  }
                }
              },
              "alignment": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "collections": {
                    "description": "Align map colons and struct equals signs in broken collections.",
                    "default": true,
                    "examples": [
                      false
                    ],
                    "type": "boolean"
                  },
                  "enums": {
                    "description": "Align equals signs and trailing comments in enum declarations.",
                    "default": true,
                    "examples": [
                      false
                    ],
                    "type": "boolean"
                  },
                  "fields": {
                    "description": "Align names, types, and equals signs in tuple, component, and graph field declarations.",
                    "default": true,
                    "examples": [
                      false
                    ],
                    "type": "boolean"
                  }
                }
              },
              "endOfLine": {
                "description": "Line ending for generated layout.",
                "default": "preserve",
                "examples": [
                  "crlf"
                ],
                "type": "string",
                "enum": [
                  "lf",
                  "crlf",
                  "preserve"
                ]
              },
              "finalNewline": {
                "description": "Append a final line ending when missing.",
                "default": true,
                "examples": [
                  false
                ],
                "type": "boolean"
              },
              "lineBreaks": {
                "description": "Reflow safe groups or retain existing breaks.",
                "default": "canonical",
                "examples": [
                  "preserve"
                ],
                "type": "string",
                "enum": [
                  "canonical",
                  "preserve"
                ]
              },
              "wrap": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "calls": {
                    "description": "Wrapping of call arguments.",
                    "default": "preserve",
                    "examples": [
                      "auto"
                    ],
                    "type": "string",
                    "enum": [
                      "preserve",
                      "auto",
                      "always",
                      "never"
                    ]
                  },
                  "parameters": {
                    "description": "Preserve parameter line-break positions or reflow function/event and function-type signatures.",
                    "default": "preserve",
                    "examples": [
                      "auto"
                    ],
                    "type": "string",
                    "enum": [
                      "preserve",
                      "auto",
                      "always",
                      "never"
                    ]
                  },
                  "collections": {
                    "description": "Wrapping of collection entries.",
                    "default": "auto",
                    "examples": [
                      "always"
                    ],
                    "type": "string",
                    "enum": [
                      "auto",
                      "always",
                      "never"
                    ]
                  },
                  "conditions": {
                    "description": "Wrapping of logical chains in conditions, assignments, returns and group items.",
                    "default": "auto",
                    "examples": [
                      "always"
                    ],
                    "type": "string",
                    "enum": [
                      "auto",
                      "always",
                      "never"
                    ]
                  }
                }
              },
              "spacing": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "operators": {
                    "description": "Spaces around binary and compound operators; required lexical separators remain.",
                    "default": "spaced",
                    "examples": [
                      "compact"
                    ],
                    "type": "string",
                    "enum": [
                      "spaced",
                      "compact"
                    ]
                  },
                  "assignment": {
                    "description": "Spaces around = and :=; inherit follows spacing.operators.",
                    "default": "inherit",
                    "examples": [
                      "compact"
                    ],
                    "type": "string",
                    "enum": [
                      "inherit",
                      "spaced",
                      "compact"
                    ]
                  },
                  "comma": {
                    "description": "Space after commas in flat groups.",
                    "default": "spaced",
                    "examples": [
                      "compact"
                    ],
                    "type": "string",
                    "enum": [
                      "spaced",
                      "compact"
                    ]
                  },
                  "brackets": {
                    "description": "Padding inside flat collections.",
                    "default": "tight",
                    "examples": [
                      "spaced"
                    ],
                    "type": "string",
                    "enum": [
                      "tight",
                      "spaced"
                    ]
                  }
                }
              },
              "imports": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sort": {
                    "description": "Sort complete imports with attached comments into standard, Contracts and project groups.",
                    "default": true,
                    "examples": [
                      false
                    ],
                    "type": "boolean"
                  }
                }
              },
              "blankLines": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "maxConsecutive": {
                    "description": "Maximum source blank lines kept between entries.",
                    "default": 1,
                    "examples": [
                      0
                    ],
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "afterImports": {
                    "description": "Blank line after the last import.",
                    "default": "always",
                    "examples": [
                      "preserve"
                    ],
                    "type": "string",
                    "enum": [
                      "always",
                      "preserve",
                      "never"
                    ]
                  },
                  "betweenMembers": {
                    "description": "Blank lines between graph or declaration members.",
                    "default": "preserve",
                    "examples": [
                      "always"
                    ],
                    "type": "string",
                    "enum": [
                      "preserve",
                      "always",
                      "never"
                    ]
                  },
                  "betweenFunctions": {
                    "description": "Enforce a blank line between function and event members in graphs.",
                    "default": "preserve",
                    "examples": [
                      "always"
                    ],
                    "type": "string",
                    "enum": [
                      "always",
                      "preserve",
                      "never"
                    ]
                  }
                }
              },
              "syntax": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "canonicalHeaders": {
                    "description": "Keep or strip redundant parentheses around if/for/while condition headers.",
                    "default": "preserve",
                    "examples": [
                      "canonical"
                    ],
                    "type": "string",
