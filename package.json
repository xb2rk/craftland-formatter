{
  "name": "fc-format-v5",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "bin": {
    "fcfmt": "./bin/fcfmt.mjs",
    "fclint": "./bin/fclint.mjs"
  },
  "exports": {
    ".": "./src/printer.mjs",
    "./config": "./src/config.mjs",
    "./service": "./src/service.mjs",
    "./lint": "./src/lint/engine.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format": "node scripts/fcfmt.mjs --write",
    "format:check": "node scripts/fcfmt.mjs --check",
    "format:diff": "node scripts/fcfmt.mjs --check --diff",
    "lint": "node bin/fclint.mjs",
    "test": "node scripts/test.mjs",
    "test:grammar": "node --test tests/grammar-oracle.test.mjs tests/layout-safety.test.mjs tests/grammar-matrix.test.mjs tests/trivia-safety.test.mjs",
    "test:syntax": "node --test tests/syntax.test.mjs tests/grammar-parity.test.mjs",
    "test:printer": "node --test tests/printer.test.mjs tests/logical-layout.test.mjs tests/collection-alignment.test.mjs tests/operator-spacing.test.mjs tests/style-parity.test.mjs tests/layout-regressions.test.mjs",
    "test:cli": "node --test tests/cli.test.mjs",
    "test:extension": "node --test tests/extension.test.mjs",
    "test:extension:host": "node scripts/test-extension-host.mjs",
    "test:extension:vsix": "node scripts/test-extension-host.mjs --vsix",
    "clean": "node scripts/clean.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "config:generate": "node scripts/gen-config-artifacts.mjs",
    "config:check": "node scripts/gen-config-artifacts.mjs --check",
    "bench:printer": "node scripts/bench-printer.mjs",
    "audit:rollout": "node scripts/audit-rollout.mjs",
    "probe:grammar": "node scripts/probe-grammar.mjs",
    "probe:compiler": "node scripts/probe-compiler.mjs",
    "probe:compiler:formatted": "node scripts/probe-compiler.mjs --formatted"
  }
}
