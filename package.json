{
  "name": "fc-format-v4",
  "version": "0.4.0",
  "private": true,
  "description": "Next-generation modular, deterministic formatter and language toolchain for Craftland Studio FC.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "fc-format-v4": "./dist/cli/format.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./grammar": {
      "types": "./dist/grammar/index.d.ts",
      "import": "./dist/grammar/index.js"
    },
    "./lex": {
      "types": "./dist/lex/index.d.ts",
      "import": "./dist/lex/index.js"
    },
    "./syntax": {
      "types": "./dist/syntax/index.d.ts",
      "import": "./dist/syntax/index.js"
    },
    "./parser": {
      "types": "./dist/parser/index.d.ts",
      "import": "./dist/parser/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js"
    },
    "./imports": {
      "types": "./dist/imports/index.d.ts",
      "import": "./dist/imports/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "grammar:generate": "node scripts/gen-token-vocabulary.mjs",
    "grammar:check": "node scripts/gen-token-vocabulary.mjs --check",
    "verify:grammar": "npm run grammar:check",
    "format": "tsx src/cli/format.ts",
    "format:check": "tsx src/cli/format.ts --check",
    "ci": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
