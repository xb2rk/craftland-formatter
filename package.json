{
  "name": "fc-format",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic formatter for Craftland Studio FC source files.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "bench": "tsx scripts/bench-format.ts",
    "bridge": "tsx src/cli/bridge.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "grammar:generate": "node scripts/gen-token-vocabulary.mjs",
    "grammar:check": "node scripts/gen-token-vocabulary.mjs --check",
    "verify:grammar": "npm run grammar:check",
    "verify:eos": "tsx scripts/verify-eos.ts",
    "oracle": "tsx src/cli/oracle.ts",
    "format": "tsx src/cli/format.ts",
    "format:check": "tsx src/cli/format.ts --check",
    "graphify": "tsx src/cli/graphify.ts",
    "lint": "tsx src/cli/lint.ts",
    "lint:json": "tsx src/cli/lint.ts --json",
    "ci": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
