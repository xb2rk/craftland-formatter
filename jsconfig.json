{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "tests/**/*",
    "extension/src/**/*",
    "config.d.ts"
  ],
  "exclude": [
    "extension/dist/**/*",
    "extension/archive/**/*"
  ]
}
