/**
 * Golden: operators - spacing, precedence, shift clinging.
 */
func Check(a int, b int) bool {
  return a + b * 2 > 10 && a != b || a >> 1 == 0
}

func Shifts(key int) {
  key = (key ^ 61) ^ (key >> 16)
  key = key + (key << 3)
  key = key ^ (key >> 4)
  var combined int = (a + b) * (c - d) / 2 % 3
}
