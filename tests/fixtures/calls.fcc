/**
 * Golden: calls - bare vs assignment
 * bare CALL (wait/Foo) when broken has trailing comma and ) on new line;
 * assignment CALL (var = / return) when broken has no trailing and ) same line as last arg.
 */

import "Convert.fcc" as Convert

[platform_server]
graph Calls {
  // bare flat - stays flat no trailing
  var _testBareFlat = 0

  // wait bare with 6 args - broken at 100 keeps comma + ) newline (isAssignment leak with preceding var)
  var keyName string = payload[1] as string
  var uploadValue object = payload[2]
  wait WriteToDataStoreV2(
    tableName,
    StorageScheduler.GetPlayerUID(request),
    keyName,
    uploadValue,
    StorageConfig.GetMapCode(),
    out var statusCode,
  )

  // var assignment - broken at 60 no trailing comma, ) same line
  var profile PlayerMainData = StorageSchemaPlayer.PrepareProfileRecord(
    rawProfile,
    out var changed,
    out var preparedResultCode)

  // return assignment - broken no trailing
  func Get() int {
    return Call(first, second, third)
  }

  // bare flat small - stays flat
  var _flatBare = 0
  StorageService.WriteValue(playerUID, DataTableName.Player, PlayerData_Key.Profile, profile)

  // bare broken - has trailing comma
  var _flatBare2 = 0
  StorageService.PromoteLoadedValue(
    playerUID,
    DataTableName.Player,
    PlayerData_Key.Profile,
    profile,
  )
}
