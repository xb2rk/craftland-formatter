/**
 * Golden: graphs - platform decorators, func/if blocks, var decls.
 * Platform bracket must stay on one line (fc-syntax.test).
 */
[platform_server]
graph PlayerGraph {
  var _Score int
  var _Active bool

  func OnTick() {
    if _Score > 0 {
      _Score = 0
    }
  }

  func Reset() {
    _Score = 0
    _Active = false
  }
}

[platform_client]
graph HudGraph {
  func OnUpdate(dt float) {
    var x int = 1
  }
}
