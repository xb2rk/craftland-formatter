// Synthetic Large Math Utility Benchmark Fixture
import "StdLibrary.fcc" as StdLibrary

graph BigMathEngine {
  // Math Routine 1: Iterative polynomial calculation
  func CalculatePolynomial1(base float, power int) float {
    var accumulator float = 1.0
    var factor float = base * 1.05 + 1.0

    for step = 0, power, 1 {
      if step % 2 == 0 {
        accumulator = (accumulator * factor) - (base / 2.0)
      } else {
        accumulator = (accumulator + factor) * 0.98
      }
    }

    var normalized float = accumulator
    if normalized > 10000.0 && factor > 0.0 {
      normalized = normalized / 100.0
    } else if normalized < -10000.0 {
      normalized = 0.0
    }

    return normalized
  }

  func TransformVector1(x float, y float, z float) List<float> {
    var scale float = 0.25
    var rx float = (x * scale) + (y * 0.5) - (z * 0.1)
    var ry float = (y * scale) + (z * 0.5) - (x * 0.1)
    var rz float = (z * scale) + (x * 0.5) - (y * 0.1)

    return List<float>{rx, ry, rz}
  }

