    var scale float = 0.25
    var rx float = (x * scale) + (y * 0.5) - (z * 0.1)
    var ry float = (y * scale) + (z * 0.5) - (x * 0.1)
    var rz float = (z * scale) + (x * 0.5) - (y * 0.1)

    return List<float>{rx, ry, rz}
