{
  "name": "fc-format-v2-vscode",
  "displayName": "FC Format v2",
  "description": "Formatter and linter for Craftland Studio .fcg/.fcc files.",
  "version": "0.1.0",
  "publisher": "fc-format",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/craftland/fc-format-v2"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Formatters",
    "Linters",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:ffugclanguage"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ffugclanguage",
        "extensions": [
          ".fcg",
          ".fcc"
        ]
      }
    ],
    "commands": [
      {
        "command": "fcFormatV2.formatDocument",
        "title": "FC Format v2: Format Document"
      },
      {
        "command": "fcFormatV2.lintDocument",
        "title": "FC Format v2: Lint Document"
      },
      {
        "command": "fcFormatV2.fixAll",
        "title": "FC Format v2: Fix All Auto-Fixable"
      }
    ],
    "configuration": {
      "title": "FC Format v2",
      "properties": {
        "fcFormatV2.printWidth": {
          "type": "number",
          "default": 100,
          "minimum": 1
        },
        "fcFormatV2.tabWidth": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 16
        },
        "fcFormatV2.useTabs": {
          "type": "boolean",
          "default": false
        },
        "fcFormatV2.endOfLine": {
          "type": "string",
          "enum": [
            "lf",
            "crlf"
          ],
          "default": "lf"
        },
        "fcFormatV2.collapseBlankLines": {
          "type": "boolean",
          "default": true
        },
        "fcFormatV2.trimTrailingWhitespace": {
          "type": "boolean",
          "default": true
        },
        "fcFormatV2.insertFinalNewline": {
          "type": "boolean",
          "default": true
        },
        "fcFormatV2.spaceAroundOperators": {
          "type": "boolean",
          "default": true
        },
        "fcFormatV2.spaceInsideParens": {
          "type": "boolean",
          "default": false
        },
        "fcFormatV2.spaceInsideBrackets": {
          "type": "boolean",
          "default": false
        },
        "fcFormatV2.spaceInsideBraces": {
          "type": "boolean",
          "default": false
        },
        "fcFormatV2.spaceAfterComma": {
          "type": "boolean",
          "default": true
        },
        "fcFormatV2.bracketSpacing": {
          "type": "string",
          "enum": [
            "none",
            "space"
          ],
          "default": "none"
        },
        "fcFormatV2.wrapCalls": {
          "type": "string",
          "enum": [
            "never",
            "auto",
            "always"
          ],
          "default": "auto"
        },
        "fcFormatV2.wrapCollections": {
          "type": "string",
          "enum": [
            "never",
            "auto",
            "always"
          ],
          "default": "auto"
        },
        "fcFormatV2.callBreakStyle": {
          "type": "string",
          "enum": [
            "breakAll",
            "hugFirst"
          ],
          "default": "breakAll"
        },
        "fcFormatV2.enableLint": {
          "type": "boolean",
          "default": false,
          "description": "Enable live diagnostics (off by default). Run Lint/FixAll commands to lint on demand."
        },
        "fcFormatV2.trailingComma": {
          "type": "string",
          "enum": [
            "never",
            "multiline",
            "always"
          ],
          "default": "multiline"
        }
      }
    }
  },
  "configurationDefaults": {
    "[ffugclanguage]": {
      "editor.defaultFormatter": "fc-format.fc-format-v2-vscode"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm --prefix .. run build && npx esbuild src/extension.ts --bundle --platform=node --target=node20 --external:vscode --outfile=dist/extension.js --format=esm --sourcemap",
    "build:install": "npm run build && npx vsce package --no-dependencies && code --install-extension fc-format-v2-vscode-0.1.0.vsix --force || echo \"code CLI not found - VSIX built\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vscode:prepublish": "npm run build",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.82.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}