{
  "name": "fc-format-v3-vscode",
  "displayName": "FC Format",
  "description": "A deterministic, compiler-safe formatter and conservative workspace linter for Craftland Studio FC files.",
  "version": "0.3.0",
  "publisher": "fc-format",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xb2rk/PlantsVsZombiesFCC.git",
    "directory": "tools/fc-format-v3/extension"
  },
  "homepage": "https://github.com/xb2rk/PlantsVsZombiesFCC/tree/main/tools/fc-format-v3/extension#readme",
  "bugs": {
    "url": "https://github.com/xb2rk/PlantsVsZombiesFCC/issues"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Formatters",
    "Programming Languages"
  ],
  "keywords": [
    "craftland",
    "fc",
    "formatter",
    "fcg",
    "fcc"
  ],
  "activationEvents": [
    "onLanguage:ffugclanguage"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "fcFormat.formatDocument",
        "title": "FC Format: Format Document",
        "category": "FC Format"
      },
      {
        "command": "fcFormat.lintDocument",
        "title": "FC Format: Lint Document",
        "category": "FC Format"
      }
    ],
    "configuration": {
      "title": "FC Format",
      "properties": {
        "fcFormat.printWidth": {
          "type": "number",
          "default": 120,
          "minimum": 20,
          "maximum": 1000,
          "description": "Preferred maximum line width for automatic wrapping."
        },
        "fcFormat.tabWidth": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 16,
          "description": "Visual width of one indentation level."
        },
        "fcFormat.useTabs": {
          "type": "boolean",
          "default": false,
          "description": "Indent with tabs instead of spaces."
        },
        "fcFormat.spaceAroundOperators": {
          "type": "boolean",
          "default": true,
          "description": "Insert spaces around binary operators when grammar-safe."
        },
        "fcFormat.spaceAfterComma": {
          "type": "boolean",
          "default": true,
          "description": "Insert a space after inline commas."
        },
        "fcFormat.wrapCalls": {
          "type": "string",
          "enum": [
            "never",
            "auto",
            "always"
          ],
          "default": "auto",
          "description": "Choose when calls and signatures wrap after commas."
        },
        "fcFormat.wrapCollections": {
          "type": "string",
          "enum": [
            "never",
            "auto",
            "always"
          ],
          "default": "auto",
          "description": "Choose when FC collection and composite values wrap after commas."
        },
        "fcFormat.collapseBlankLines": {
          "type": "boolean",
          "default": true,
          "description": "Collapse repeated blank lines to one blank line."
        },
        "fcFormat.insertFinalNewline": {
          "type": "boolean",
          "default": true,
          "description": "End formatted files with one newline."
        },
        "fcFormat.lint.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show P7B/P7C/P7D.3E static-analysis diagnostics for FC files."
        },
        "fcFormat.lint.suppressions": {
          "type": "boolean",
          "default": true,
          "description": "Honor fc-lint-disable-next-line comments."
        },
        "fcFormat.lint.ignoredOutVariables": {
          "type": "boolean",
          "default": true,
          "description": "Do not report out var bindings that are intentionally write-only."
        },
        "fcFormat.lint.rules": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "off",
              "error",
              "warning",
              "information",
              "hint"
            ]
          },
          "description": "Override individual FC lint rule severities by rule ID."
        }
      }
    }
  },
  "configurationDefaults": {
    "[ffugclanguage]": {
      "editor.defaultFormatter": "fc-format.fc-format-v3-vscode"
    }
  },
  "files": [
    "dist/extension.js",
    "dist/extension.js.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/build-core.mjs && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --out dist/fc-format-v3-vscode.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "keytar@7.9.0": true
  }
}
